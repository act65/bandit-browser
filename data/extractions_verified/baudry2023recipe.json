   "bound": {
    "notation": "limsup",
    "expression": "(1+c_alg)*log(T)/D_pi_k",
    "expression_latex": "\\bE[N_k(T)] \\leq (1+c) \\frac{\\log(T)}{D_\\pi(F_k, \\mu^\\star)} + o_c(\\log(T))",
    "regime": "any c > lim_n a_n"
   },
   "symbols": {
    "D_pi_k": "D_pi(F_k, mu_star): divergence of arm k's distribution to the optimal mean",
    "N_k(T)": "expected number of pulls of suboptimal arm k"
   },
   "conditions": [
    "policy satisfies Assumption 1 or its relaxation (Assumption 5)",
    "D_pi satisfies Assumption 2 (A1)-(A4) on F",
    "if a_n = 0: D_pi(F, mu) bounded above by a constant D_mu^+ for all F in F, mu <= mu_star"
   ],
   "tuning": [
    "a_n positive (or a_n = 0 under the boundedness condition)"
   ],
   "is_new": true,
   "source": {
    "label": "th::main_result",
    "number": "Theorem 1",
    "quote": "Then, for any $c > \\displaystyle \\lim_{n\\to \\infty} a_n$, if $(a_n)_{n\\in \\N}$ is \\textbf{positive} it holds that \\[\\forall k: \\Delta_k>0, \\quad \\bE[N_k(T)] \\leq (1+c) \\frac{\\log(T)}{D_\\pi(F_k, \\mu^\\star)} + o_c(\\log(T)) \\;.\\] Furthermore, the bound holds for $a_n=0$ ..."
   },
   "confidence": "medium",
   "notes": "Bound on expected pull count of each suboptimal arm; regret = sum Delta_k E[N_k(T)]. Recorded as limsup E[N_k]/log T <= (1+c)/D."
  },
