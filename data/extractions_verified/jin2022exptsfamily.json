   "bound": {
    "notation": "O",
    "expression": "sum_big(Delta_i + v_mom*log(T*Delta_i**2/v_mom)/Delta_i) + Delta_small_max*T",
    "expression_latex": "\\sum_{i\\in [K]:\\Delta_i>\\lambda} O\\bigg(\\Delta_i+\\frac{V\\log(T\\Delta_i^2/V)}{\\Delta_i} \\bigg)+\\max_{i\\in [K],\\Delta_i\\leq \\lambda} \\Delta_i \\cdot T",
    "regime": "any lambda >= 16*sqrt(V/T)"
   },
   "symbols": {
    "v_mom": "uniform bound V on the variance of the exponential family distributions",
    "sum_big": "sum over arms with Delta_i > lambda",
