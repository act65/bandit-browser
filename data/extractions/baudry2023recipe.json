   "symbols": {
    "D_pi_k": "D_pi(F_k, mu_star), divergence of arm k's distribution to optimal mean"
   },
   "conditions": [
    "policy satisfies Assumption 1 or 5 with divergence D_pi satisfying Assumption 2 on F",
    "if a_n=0, D_pi(F,mu) bounded above by D_mu^+ for mu<=mu_star"
   ],
   "tuning": [
    "a_n positive (or a_n = 0 with bounded divergence)"
   ],
   "is_new": true,
   "source": {
    "label": "th::main_result",
    "number": "Theorem 1",
    "quote": "Then, for any $c > \\displaystyle \\lim_{n\\to \\infty} a_n$, if $(a_n)_{n\\in \\N}$ is \\textbf{positive} it holds that \\[\\forall k: \\Delta_k>0, \\quad \\bE[N_k(T)] \\leq (1+c) \\frac{\\log(T)}{D_\\pi(F_k, \\mu^\\star)} + o_c(\\log(T)) \\;.\\] Furthermore, the bound holds for $a_n=0$ ..., if $D_\\pi$ is upper bounded"
   },
   "confidence": "medium",
   "notes": "Bound on expected pulls of a suboptimal arm, plus o_c(log T); recorded as limsup on the leading term."
  },
