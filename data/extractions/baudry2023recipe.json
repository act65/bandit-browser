    "expression": "(1+c_alg)*log(T)/D_pi_k",
    "expression_latex": "\\bE[N_k(T)] \\leq (1+c) \\frac{\\log(T)}{D_\\pi(F_k, \\mu^\\star)} + o_c(\\log(T))",
    "regime": "c > lim a_n"
