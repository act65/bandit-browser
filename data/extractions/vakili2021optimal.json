   "conditions": [
    "||f||_{H_k} <= B (S = B)",
    "Assumption 4: discretization D_n with f(x)-f([x]_n) <= 1/sqrt(n) and |D_n| <= C B^d n^{d/2}",
    "noise i.i.d. R-sub-Gaussian (sigma = R)"
   ],
   "tuning": [
    "GP regularisation parameter lambda > 0"
