    "expression_latex": "\\sqrt{\\frac{2\\gamma_N}{\\log(1+\\frac{1}{\\lambda^2})N}}\\left(2B+\\beta(\\frac{\\delta}{3}) + \\beta\\bigg(\\frac{\\delta}{3C\\left(B+\\sqrt{N}\\beta(2\\delta/3N)\\right)^dN^{d/2}}\\bigg)\\right) + \\frac{2}{\\sqrt{N}},\\ \\beta(\\delta)=\\frac{R}{\\lambda}\\sqrt{2\\log(1/\\delta)}",
