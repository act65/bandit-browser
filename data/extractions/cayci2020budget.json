    "expression": "alpha_ucb*sum_subopt(log(2*B/mu_low)*(42*sigma_i_sq/(Delta_i*EX_i) + 42*(M_R + r_i*M_X) + 21*M_X*Delta_i)) + C_0",
    "expression_latex": "\\alpha\\sum_{k:\\Delta_k>0}\\log\\Big(\\frac{2B}{\\mu_*}\\Big)C_k^{\\tt B1}+O(1),\\ C_k^{\\tt B1} =\\frac{42\\sigma_{k}^2}{\\Delta_k\\bE[X_{1,k}]}+ 42M_k+21M_X\\Delta_k",
    "regime": null
   },
   "symbols": {
    "B": "cost budget",
    "alpha_ucb": "exploration parameter alpha > 2 of the algorithm",
    "mu_low": "mu_* = min_k E[X_{1,k}] > 0",
    "EX_i": "mean cost E[X_{1,i}] of arm i",
    "sigma_i_sq": "V(X,R)+(r*-omega_i)^2 Var(X_{1,i}), with V the LMMSE residual variance",
    "r_i": "reward rate E[R]/E[X] of arm i",
    "M_X": "almost-sure bound on |X|",
    "M_R": "almost-sure bound on |R|",
    "C_0": "constant independent of B",
    "Delta_i": "reward-rate gap r* - r_i"
   },
   "conditions": [
    "|X_{1,k}| <= M_X and |R_{1,k}| <= M_R a.s.",
    "E[X_{1,k}] >= mu_* > 0",
    "omega_k <= r_k for all k"
   ],
   "tuning": [
    "alpha > 2",
    "L = 2",
    "lambda = 1.28",
    "b <= E[X_{1,k}]/2"
   ],
   "is_new": true,
   "source": {
    "label": "thm:ucb-b1",
    "number": "Theorem 1",
    "quote": "Bounded Cost and Reward: If |X_{1,k}|\\leq M_X, |R_{1,k}|\\leq M_R a.s., \\alpha > 2 and L=2, then the regret under UCB-B1 is upper bounded as: Reg_{\\pi^{\\tt B1}}(B) \\leq \\alpha\\sum_{k:\\Delta_k>0}\\log(\\frac{2B}{\\mu_*})C_k^{\\tt B1}+O(1), ... C_k^{\\tt B1} =\\frac{42\\sigma_{k}^2}{\\Delta_k\\bE[X_{1,k}]}+ 42M_k+21M_X\\Delta_k"
   },
   "confidence": "medium",
   "notes": "Budget B plays role of horizon. Regret is against the optimal (adaptive) budget-feasible policy, defined via expected rewards; recorded as pseudo_regret. Additive O(1) represented by constant C_0. Algorithm does not use B (uses log n), so anytime."
  },
