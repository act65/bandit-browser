   "bound": {
    "notation": "O_tilde",
    "expression": "sqrt(K*T*Reg_batch)",
    "expression_latex": "\\tilde O(\\sqrt{A\\,T\\,\\Reg_{\\mathrm{batch}}(T)})",
    "regime": null
   },
   "symbols": {
    "Reg_batch": "square-loss regret Reg_batch(T) >= 1 of the batch online regression oracle"
   },
   "conditions": [
    "realizability f* in F",
    "||s||_1 <= m for all s",
    "oracle predictions in [0,1]"
   ],
   "tuning": [
    "gamma = sqrt(A T / Reg_batch(T))"
   ],
   "is_new": true,
   "source": {
    "label": "thm:regret-sqcb-comb-regsq",
    "number": "Theorem 1",
    "quote": "Suppose \\Cref{assum:realizable,assum:action-size} hold and \\sqcomb\\ uses a batch online regression oracle with square-loss regret bound $\\Reg_{\\mathrm{batch}}(T)\\geq1$ and predictions in $[0,1]$, and a constant exploration parameter $\\gamma = \\sqrt{A T / \\Reg_{\\mathrm{batch}}(T)}$.\n    Then the expected regret of \\sqcomb\\ is bounded as\n    \\[\n        \\EE\\sbr{\\Regret(T)} \\leq \\upboundlog{\\sqrt{A\\,T\\,\\Reg_{\\mathrm{batch}}(T)}}.\n    \\]"
   },
   "confidence": "medium",
   "notes": "K denotes the paper's A (number of base arms). Regret defined via f* means, so pseudo-regret against per-context optimal action. Compute polynomial given oracles."
  },
