   "source": {
    "label": "thm:2armsFC",
    "number": "Theorem 6",
    "quote": "Any algorithm that is $\\delta$-PAC on $\\cM$ satisfies, for all $\\delta \\in )0,1]$, \\[ \\bE_\\nu[\\tau]\\geq \\frac{1}{c_*(\\nu)} \\log\\left(\\frac{1}{2.4 \\delta}\\right), \\ \\ \\text{where} \\ \\ \\ c_*(\\nu) := \\inf_{(\\nu_1',\\nu_2')\\in\\cM: \\mu_1'<\\mu_2'} \\max\\left\\{\\K(\\nu_{1},\\nu_{1}'),\\K(\\nu_{2},\\nu_{2}')\\right\\}.\\]"
   },
   "confidence": "high",
   "notes": "For Gaussian known variances c_* = (mu1-mu2)^2/(2(sigma1+sigma2)^2)."
  },
