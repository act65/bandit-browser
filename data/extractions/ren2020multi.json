   "tuning": [],
   "is_new": true,
   "source": {
    "label": "Thm:LB",
    "number": "Theorem (Thm:LB)",
    "quote": "Let $\\epsilon > 0$ be given. Assume that the rewards of all arms follow Bernoulli distributions. The regret $R(T)$ of any $\\epsilon$-LDP policy satisfies \\liminf_{T\\rightarrow \\infty}\\frac{R(T)}{\\log{T}} \\geq \\frac{1}{(e^\\epsilon - e^{-\\epsilon})^2} \\sum_{a:\\Delta_a > 0}\\frac{1}{\\Delta_a}."
   },
   "confidence": "high",
   "notes": "Stated for any eps-LDP policy; proof handles non-consistent policies by showing their regret is omega(log T). For small eps approx 1/(4 eps^2) sum 1/Delta_a."
  },
