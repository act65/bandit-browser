   "bound": {
    "notation": "liminf",
    "expression": "1/(exp(eps_dp) - exp(-eps_dp))**2*sum_subopt(1/Delta_i)*log(T)",
    "expression_latex": "\\liminf_{T\\rightarrow \\infty}\\frac{R(T)}{\\log{T}} \\geq \\frac{1}{(e^\\epsilon - e^{-\\epsilon})^2} \\sum_{a:\\Delta_a > 0}\\frac{1}{\\Delta_a}",
    "regime": "T -> infinity"
