   "bound": {
    "notation": "liminf",
    "expression": "2*log(T)/Delta_Q_i**2",
    "expression_latex": "\\liminf_{T\\to\\infty}\\frac{E[n_i(T)]}{\\log T} \\geq \\frac{2}{\\Delta_{Q,i}^2}, \\ i<a^*",
    "regime": "for low-cost arms i < a*"
   },
   "symbols": {
    "Delta_Q_i": "quality gap (1-alpha) mu_ell - mu_i of arm i"
   },
   "conditions": [
    "consistent policies: E[n_i(T)] = o(T^gamma) for all gamma in (0,1] and all i != a*",
    "Gaussian rewards with variance sigma^2 = 1"
   ],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "thm:known_ell_lb",
    "number": "Theorem 3.1",
    "quote": "Under any consistent policy $\\pi$ the expected number of samples of a low cost arm and of the reference arm $\\ell$ are lower bounded as, \\liminf ... \\geq \\frac{2 }{ \\gap_{Q, i}^2 }, for arms i<a^*, ... \\geq \\max_{i \\leq a^*} \\frac{2 (1-\\alpha)^2}{ \\gap_{Q, i}^2 }. Where T denotes the problem horizon and the rewards of all K arms are Gaussian distributed with variance $\\sigma^2 = 1$."
   },
   "confidence": "high",
   "notes": "Bound on expected pull count of each low-cost arm (implies quality regret lower bound). General-model version via D_inf in Theorem E.1."
  },
