   "compute": "polynomial",
   "bound": {
    "notation": "O_tilde",
    "expression": "exp(-T/H_2_eps)",
    "expression_latex": "\\ep{-\\hTT{\\fr{T}{H_2(\\eps)}}}",
    "regime": "T >= Theta_tilde(max_{i>=g(eps)+1} i/Delta_i^2)"
   },
   "symbols": {
    "H_2_eps": "H_2(eps) = (1/g(eps/2)) max_{i>=g(eps)+1} i/Delta_i^2, g(eps)=number of eps-good arms",
    "epsilon": "any eps in (0,1), not an input to SH"
   },
   "conditions": [
    "eps in (0,1)",
    "1-sub-Gaussian noise (sigma=1)",
    "means in [0,1]"
   ],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "them:ins_dep",
    "number": "Theorem 1",
    "quote": "For any $\\eps\\in(0,1)$, the $\\eps$-error probability of SH satisfies $\\pp{\\mu_{J_T}<\\mu_1-\\eps}\\le\\ep{-\\hTT{\\fr{T}{H_2(\\eps)}}}$, for $T\\ge\\hTT{\\max_{i\\ge g(\\eps)+1}\\frac{i}{\\Delta_i^2}}$."
   },
   "confidence": "medium",
   "notes": "Theta-tilde is inside the exponent; recorded as O_tilde of exp(-T/H_2). Corollary 1 shows H_2(eps) < 4/eps^2 for Polynomial(alpha) instances with alpha>1/2."
  },
  {
   "id": "r2",
