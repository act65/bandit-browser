    "expression_latex": "\\sum_{i \\in A'} \\left({32\\sigma^2 \\log \\omega^* \\over \\gap{i}} + \\gap{i}\\right) + 3\\maxgap K + {\\maxgap K^3 \\over \\omega^*}",
    "regime": null
