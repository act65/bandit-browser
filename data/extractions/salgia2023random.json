   "is_new": true,
   "source": {
    "label": "thm:noiseless_regret",
    "number": "Theorem 4.3",
    "quote": "Assume that the kernel $k$ satisfies the polynomial eigendecay condition with parameter $\\beta > 1$ and function $f$ satisfies Assumption~\\ref{assumption:f_level_set_regularity}. For a given $\\delta \\in (0,1)$, if REDS algorithm is run with $N_1 \\geq C_{L_f, L_f'} \\overline{N}(\\delta/\\log_2(T))$ and noise-free feedback, then the regret incurred by REDS satisfies, $R(T) = \\tilde{\\cO}(\\max\\{T^{\\frac{3-\\beta}{2}}, 1\\})$ with probability at least $1 - \\delta$."
   },
   "confidence": "high",
   "notes": "Holds w.p. 1-delta. Constants depend on f (M_f, L_f, L_f') and B. Proof splits cases beta<3, =3, >3."
  },
