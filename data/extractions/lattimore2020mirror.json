   "source": {
    "label": "thm:info",
    "number": "Theorem 5",
    "quote": "Suppose a partial monitoring game has an information ratio of $(\\alpha, \\beta, \\lambda)$ with $\\alpha, \\beta \\geq 0$ and $\\lambda \\geq 1$. Then, for any finitely supported distribution $\\mu$ on $\\cZ^n$, there exists a policy $\\pi$ such that $\\BReg_n(\\pi, \\mu) \\leq n (\\epsd + \\alpha) + (\\beta n)^{1 -1/\\lambda} \\diam(\\cD)^{1/\\lambda}$."
   },
   "confidence": "high",
   "notes": "Existence statement; policy in proof samples from exploratory distributions given posterior."
  },
