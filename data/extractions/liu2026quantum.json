   "source": {
    "label": "thm:qmab-lb",
    "number": "Theorem 3.1",
    "quote": "There exists a universal constant c>0 such that, for every K\\ge2, T\\ge1, and any quantum multi-armed bandit policy \\pi over T rounds, there exists an instance \\nu\\in\\mathcal B_K such that R_T^\\pi(\\nu)\\ge cK\\log(1+\\frac{T}{K})."
   },
   "confidence": "high",
   "notes": "Universal constant c unspecified, recorded as Omega. Holds also for tests with controlled queries; also holds under bounded-variance assumption (Remark 3.7)."
  },
