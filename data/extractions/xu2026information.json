   ],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "thm:mab_info_gain",
    "number": "Theorem 5",
    "quote": "Consider a finite-armed bandit with Gaussian noise $W_{t+1} \\sim \\mathcal{N}(0, \\sigma^2)$ and let $\\theta \\in \\R^{|\\actions|}$ be a random vector with finite covariance matrix $\\Sigma$. Then for all $T\\ge 1$ and all agents $\\pi$, \\infoGain{T}{\\pi} \\le \\frac{1}{2} \\log \\det ( I + \\frac{T }{\\sigma^2}\\Sigma ) + \\frac{1}{2} = O(|\\actions|\\log T)=o(T)."
   },
   "confidence": "medium",
   "notes": "Information gain bound; exact form also given with log det."
  },
  {
   "id": "r3",
