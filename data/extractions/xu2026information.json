   "bound": {
    "notation": "exact",
    "expression": "D_trunc*log(1 + T/(sigma**2*D_trunc))/2 + delta_D*T/(2*sigma**2)",
    "expression_latex": "\\frac{1}{2}D\\log\\left(1+\\frac{T}{\\sigma^2D}\\right) + \\frac{\\delta_D T}{2\\sigma^2}",
    "regime": "for all D >= 1"
   },
   "symbols": {
    "D_trunc": "truncation level D >= 1 of Mercer expansion",
