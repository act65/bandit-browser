   "tuning": [],
   "is_new": true,
   "source": {
    "label": "thm:linear_bandit_info_gain",
    "number": "Theorem (thm:linear_bandit_info_gain)",
    "quote": "Consider a $d$-dimensional linear bandit with Gaussian noise. Let the action set $\\actions \\subseteq \\{a : \\|a\\|_2 \\le 1\\}$. Let $\\theta$ be a random vector with covariance matrix $\\Sigma$. Then, for all $T \\ge 1$ and all agents $\\pi$, $\\gamma_T(\\pi) \\le \\frac{1}{2} \\log \\det(I_d + \\frac{T}{\\sigma^2}\\Sigma) + \\frac{1}{2} = O(d \\log T) = o(T)$."
   },
   "confidence": "medium",
   "notes": "Upper bound on information gain I(theta;H_T) holding for every agent (not a regret bound). Quantity 'other'."
  },
