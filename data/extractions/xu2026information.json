   "tuning": [],
   "is_new": true,
   "source": {
    "label": "thm:gp_bandit_info_gain",
    "number": "Theorem (thm:gp_bandit_info_gain)",
    "quote": "Consider the Gaussian process bandit defined above with Gaussian noise of variance $\\sigma^2$. Then, for all $T\\ge 1$, all agents $\\pi$ and all $D \\ge 1$, $\\gamma_T(\\pi) \\le \\frac{1}{2}D\\log(1+\\frac{T}{\\sigma^2D}) + \\frac{\\delta_D T}{2\\sigma^2}$. Consequently, if $\\delta_D \\to 0$, then $\\sup_{\\pi}\\gamma_T(\\pi) = o(T)$."
   },
   "confidence": "medium",
   "notes": "Adapted from Vakili et al. 2021 Theorem 3; information-gain bound, not regret."
  },
