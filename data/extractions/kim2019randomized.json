   "bound": {
    "notation": "exact",
    "expression": "(c_1 + c_2)*(1 + 2/(p_3 - p_2))*sqrt(c_3*T) + T*(p_1 + p_2) + d + 2*sqrt(d/lam)*D_w**(3/2)*V_T + (4/lam)*gamma**D_w/(1 - gamma)*T",
    "expression_latex": "(c_1+ c_2) ( 1+ \\frac{2}{p_3-p_2}) \\sqrt{c_3 T } + T (p_1+p_2) + d + 2\\sqrt{\\frac{d}{\\lambda}} D^{3/2} B_T  + \\frac{4}{\\lambda} \\frac{\\gamma^D}{1-\\gamma}T",
    "regime": "for any integer D > 0"
   },
   "symbols": {
    "c_1": "width of WLS confidence event E^wls",
    "c_2": "concentration width of the perturbation",
    "p_1": "failure probability of E^wls",
    "p_2": "failure probability of E_t^conc",
    "p_3": "lower bound on probability of anti-concentration event",
    "c_3": "2 d log(1/gamma) + 2 (d/T) log(1 + 1/(d lam (1-gamma)))",
    "gamma": "discount factor",
    "D_w": "the paper's integer D (critical window), free analysis parameter"
   },
   "conditions": [
    "c_1, c_2 >= 1 with P(E^wls) >= 1-p_1, P(E_t^conc) >= 1-p_2, P(E_t^anti) >= p_3"
   ],
   "tuning": [
    "0 < gamma < 1",
    "lam >= 1"
   ],
   "is_new": true,
   "source": {
    "label": "thm:regret-non",
    "number": "Theorem 7",
    "quote": "Assume we have $c_1, c_2\\ge 1$ satisfying $P(E^{wls}) \\ge 1-p_1$, $P(E_t^{conc}) \\ge 1-p_2$, and $P(E_t^{anti}) \\ge p_3$ ... The expected dynamic regret of A is bounded as for any integer $D>0$, $E[R(T)] \\le (c_1+ c_2) ( 1+ \\frac{2}{p_3-p_2}) \\sqrt{c_3 T } + T (p_1+p_2) + d + 2\\sqrt{\\frac{d}{\\lambda}} D^{3/2} B_T  + \\frac{4}{\\lambda} \\frac{\\gamma^D}{1-\\gamma}T.$"
   },
   "confidence": "medium",
   "notes": "Generic bound for any perturbation algorithm satisfying the event conditions; paper's D renamed D_w (not a delay). V_T = paper's B_T."
  },
