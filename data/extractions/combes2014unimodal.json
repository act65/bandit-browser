    "c_theta": "sum over neighbours k of the optimal arm in G of (mu_star - mu_k)/I_min(theta_k, theta_star), with I_min the K_inf-type minimal divergence within the parametric family"
   },
   "conditions": [
    "reward distributions belong to the one-parameter family V"
   ],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "th:graves_lai",
    "number": "Theorem 4.1",
    "quote": "Let $\\pi\\in \\Pi$ be a uniformly good algorithm, and assume that $\\nu_k = \\nu(\\theta_k) \\in {\\cal V}$ for all $k$. Then for any $\\theta\\in \\Theta_G$, \\lim \\inf_{T \\to +\\infty} \\frac{R^{\\pi}(T)}{ \\log(T)}  \\geq c(\\theta) = \\sum_{(k,k^*) \\in E} \\frac{ \\mu^{\\star} - \\mu_k}{I_{\\min}(\\theta_k, \\theta^{\\star})}."
   },
   "confidence": "high",
   "notes": "Derived via Graves-Lai. Sum is only over neighbours of the optimal arm, independent of K. For Bernoulli, I_min = Bernoulli KL."
  },
