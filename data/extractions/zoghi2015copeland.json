    "expression_latex": "N_{ij}^{\\delta}(T) \\leq \\widehat{N}_{ij}^{\\delta}(T) = \\frac{4\\alpha\\ln T}{(\\Delta^*_{ij})^2}",
    "regime": "T > C(delta), i != j"
   },
   "symbols": {
    "alpha_ccb": "exploration parameter alpha > 1/2 of CCB",
    "Delta_star_ij": "modified gap Delta*_ij (Definition 3)"
   },
   "conditions": [
    "Assumption A: no ties p_ij != 0.5",
    "T > C(delta) = ((4alpha-1)K^2/((2alpha-1)delta))^(1/(2alpha-1))"
   ],
   "tuning": [
    "alpha > 0.5"
   ],
   "is_new": true,
   "source": {
    "label": "prop:counts",
    "number": "Proposition 4",
    "quote": "Given any $\\delta > 0$ and $\\alpha > 0.5$, if we apply CCB (Algorithm \\ref{alg:CCB}) to a dueling bandit problem satisfying Assumption {\\bf A}, the following holds with probability $1-\\delta$: for any $T>C(\\delta)$ and any pair of arms $a_i$ and $a_j$, we have $N_{ij}^{\\delta}(T) \\leq \\widehat{N}_{ij}^{\\delta}(T)$."
   },
   "confidence": "medium",
   "notes": "Bound on number of times a_i chosen as optimistic Copeland winner and a_j as challenger after time C(delta); 0 if i=j>C."
  },
