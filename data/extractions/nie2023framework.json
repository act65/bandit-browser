   "bound": {
    "notation": "O",
    "expression": "delta_rob**(2/3)*N_q**(1/3)*T**(2/3)*log(T)**(1/3)",
    "expression_latex": "\\mathcal{O}\\left(\\delta^\\frac{2}{3}N^\\frac{1}{3} T^\\frac{2}{3}\\log(T)^\\frac{1}{3}\\right)",
    "regime": "T >= max(N, 2*sqrt(2)*N/delta)"
   },
   "symbols": {
    "delta_rob": "robustness coefficient delta of the (alpha,delta)-robust offline approximation algorithm",
    "N_q": "upper bound on the number of value-oracle queries made by the offline algorithm"
   },
   "conditions": [
    "offline subroutine is an (alpha,delta)-robust approximation algorithm",
    "T >= max{N, 2 sqrt(2) N / delta}"
   ],
   "tuning": [
    "m = ceil(delta^{2/3} T^{2/3} log(T)^{1/3} / (2 N^{2/3}))"
   ],
   "is_new": true,
   "source": {
    "label": "thm:main",
    "number": "Theorem 1",
    "quote": "For the sequential decision making problem defined in Section 2, with $T\\geq \\max\\left\\{N, \\frac{2\\sqrt{2}N}{\\delta}\\right\\}$, the expected cumulative $\\alpha$-regret of C-ETC using an $(\\alpha,\\delta)$-robust approximation algorithm as subroutine is at most $\\mathcal{O}\\left(\\delta^\\frac{2}{3}N^\\frac{1}{3} T^\\frac{2}{3}\\log(T)^\\frac{1}{3}\\right)$, where $N$ upper-bounds the number of value oracle queries made by the offline algorithm $\\mathcal{A}$."
   },
   "confidence": "high",
   "notes": "Proof gives explicit bound 3 delta^{2/3} N^{1/3} T^{2/3} log(T)^{1/3} + 2N. Regret defined through expected reward f, alpha-regret vs alpha*f(OPT). Remark 4 says a doubling trick gives an anytime version with same rate (not formally stated). Compute depends on the offline algorithm (no overhead)."
  },
