   "source": {
    "label": "th:distribfree",
    "number": "Theorem 1",
    "quote": "Given $T \\geq 1$, the regret of the KL-UCB-Switch algorithm, tuned with the knowledge of $T$ and the switch function $f(T, K) = \\lfloor (T/K)^{1/5} \\rfloor$, is uniformly bounded over all bandit problems $\\unu$ over $[0,1]$ by R_T \\leq (K-1) + 23 \\sqrt{KT}."
   },
   "confidence": "high",
   "notes": "R_T defined as T mu* - E[sum mu_{A_t}], i.e. pseudo-regret."
  },
