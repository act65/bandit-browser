   "compute": "polynomial",
   "bound": {
    "notation": "exact",
    "expression": "2*D + K*E*(D+1)*log(K)/gamma_lr + gamma_lr*(alpha_d/(2*(1-exp(-1))*(D+1)*N) + 3/(K*E))*T",
    "expression_latex": "2d + \\frac{Ke(d+1)\\ln K}{\\gamma} + \\gamma\\left(\\frac{\\alpha(G_{\\le d})}{2(1-e^{-1})(d+1)N} + \\frac{3}{Ke}\\right)T",
    "regime": null
   },
   "symbols": {
    "gamma_lr": "free learning-rate parameter gamma in (0,1], eta = gamma/(K e (d+1))",
    "alpha_d": "independence number of the d-th power G_{<=d} of the communication graph",
    "D": "common delay parameter d",
    "N": "number of agents"
   },
   "conditions": [
    "G connected undirected",
    "oblivious adversary, losses in [0,1]"
   ],
   "tuning": [
    "eta = gamma/(K*e*(d+1)), gamma in (0,1]"
   ],
   "is_new": true,
   "source": {
    "label": "th:nontuned",
    "number": "Theorem (th:nontuned)",
    "quote": "The regret of {\\sc Exp3-Coop} run over a network $G = (V,E)$ of $N$ agents, each using delay $d$ and learning rate $\\eta = \\gamma\\big/\\bigl(Ke(d+1)\\bigr)$, for $\\gamma \\in (0,1]$, satisfies \\[ R_T^{\\mathrm{coop}} \\le 2d + \\frac{Ke(d+1)\\ln K}{\\gamma} + \\gamma\\left(\\frac{\\alpha(G_{\\le d})}{2(1-e^{-1})(d+1)N} + \\frac{3}{Ke}\\right)T~. \\]"
   },
   "confidence": "medium",
   "notes": "Average welfare regret (comparison of expected average loss vs best fixed action against oblivious adversary); recorded as pseudo_regret since oblivious losses make these coincide. Bound holds for each fixed gamma; optimizing gamma would require T."
  },
  {
   "id": "r2",
