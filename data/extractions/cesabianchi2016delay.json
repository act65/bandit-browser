    "expression_latex": "\\mathcal{O}\\left(\\sqrt{(\\ln K)\\left(d + 1+ \\frac{K}{N}\\,\\alpha(G_{\\le d})\\right)T} + d\\,\\log T \\right)",
    "regime": "T large (hides T-independent additive terms polynomial in other parameters)"
   },
   "symbols": {
