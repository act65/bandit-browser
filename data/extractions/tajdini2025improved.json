    "regime": null
   },
   "symbols": {
    "b": "bound on ||theta*||_2",
    "beta_reg": "regularisation parameter beta >= 0 of the design objective",
    "M_star": "action-set complexity M*_{1+eps}(A, T^{-2eps/(1+eps)}, beta) = max over subsets V of min over designs of M_{1+eps}",
    "v_mom": "upsilon, bound on E|eta|^{1+eps}"
   },
   "conditions": [
    "||theta*||_2 <= b",
    "sup_x |<x,theta*>| <= 1",
    "E|eta_t|^{1+eps} <= upsilon"
   ],
   "tuning": [
    "gamma = T^{-2eps/(1+eps)}",
    "truncated empirical mean estimator"
   ],
   "is_new": true,
   "source": {
    "label": "thm: main-upper",
    "number": "Theorem 3",
    "quote": "For any linear bandit problem with finite action set A ... If E[|eta_t|^{1+eps}] <= upsilon, ||theta*||_2 <= b, and sup |a^T theta*| <= 1, then MED-PE with the truncated empirical mean estimator and gamma = T^{-2eps/(1+eps)} achieves regret bounded by (C_0 beta^{-1} b + C_1 (1+upsilon)^{1/(1+eps)} log(|A| T log^2 T)^{eps/(1+eps)}) M*^{1/(1+eps)} T^{1/(1+eps)} for some constants C_0 and C_1."
   },
   "confidence": "medium",
   "notes": "Unspecified constants C_0, C_1 -> O notation. Proof bounds E[R_T] with R_T defined through means, so pseudo-regret. Remark 1 extends to infinite sets with log|A| replaced by d log(T^2 log^2 T)."
  },
