   "is_new": true,
   "source": {
    "label": "thm:dew",
    "number": "Theorem 1",
    "quote": "In particular, if $T$ and $D$ are known and $\\eta = \\sqrt{ \\frac{\\ln K}{ \\frac{KTe}{2} + D}} \\leq \\frac{1}{4e\\dmax}$, we have \\bar{\\mathcal{R}}_{T} \\leq 2 \\sqrt{  \\left ( \\frac{KTe}{2} + D \\right) \\ln K}."
   },
   "confidence": "high",
   "notes": "Requires d_max small enough relative to sqrt((KT+D)/ln K)."
  },
