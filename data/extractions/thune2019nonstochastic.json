   "bound": {
    "notation": "exact",
    "expression": "Max(log(K)/eta, 4*E*d_max*log(K)) + eta*(K*T*E/2 + D_tot)",
    "expression_latex": "\\max \\left \\{ \\frac{\\ln K}{\\eta}, 4e\\dmax \\ln K \\right \\} + \\eta \\left ( \\frac{KTe}{2} + D \\right)",
    "regime": null
   },
   "symbols": {
    "d_max": "known upper bound on all delays",
    "D_tot": "total delay sum_{t=1}^T d_t"
   },
   "conditions": [
    "d_max >= max_t d_t is known"
   ],
   "tuning": [
    "learning rate eta (truncated to min{eta, 1/(4e d_max)})"
   ],
   "is_new": true,
   "source": {
    "label": "thm:dew",
    "number": "Theorem 1",
    "quote": "Under the assumption that an upper bound on the delays $\\dmax$ is known, the regret of Algorithm~\\ref{alg:dew} with a learning rate $\\eta$ against an oblivious adversary satisfies \\bar{\\mathcal{R}}_{T} \\leq \\max \\left \\{ \\frac{\\ln K}{\\eta}, 4e\\dmax \\ln K \\right \\} + \\eta \\left ( \\frac{KTe}{2} + D \\right), where $D=\\sum_{t=1}^T d_t$."
   },
   "confidence": "high",
   "notes": "Paper's D is the total delay (renamed D_tot). Regret against oblivious adversary with deterministic losses."
  },
  {
   "id": "r2",
   "setting": "s2",
   "side": "upper",
   "algorithm": "a1",
   "algorithm_class": null,
   "quantity": "expected_regret",
   "dependence": "worst_case",
