    "expression": "2*sqrt((K*T*E/2 + D_tot)*log(K))",
    "expression_latex": "2 \\sqrt{  \\left ( \\frac{KTe}{2} + D \\right) \\ln K}",
    "regime": "sqrt(log(K)/(K*T*E/2 + D_tot)) <= 1/(4*E*d_max)"
   },
   "symbols": {
    "d_max": "known upper bound on all delays",
    "D_tot": "total delay sum_{t=1}^T d_t"
   },
   "conditions": [
    "T and D_tot known",
    "d_max known",
    "eta = sqrt(ln K/(KTe/2 + D)) <= 1/(4e d_max)"
