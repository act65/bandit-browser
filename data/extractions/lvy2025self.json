   ],
   "is_new": true,
   "source": {
    "label": "thm:regret_scftpl_hypercube",
    "number": "Theorem (thm:regret_scftpl_hypercube)",
    "quote": "Let D be the d-self-concordant perturbation for [-1,1]^d defined in Proposition~\\ref{prop:scperturbation_hypercube_existence}. Assume that n/ln n \\ge 36 d. Then, SC-FTPL on the hypercube with perturbation distribution D and learning rate \\eta=\\sqrt{3\\ln n/n} has regret bounded by R_n\\le \\frac{2\\sqrt{3}}{3} d\\sqrt{n \\ln n}+2."
   },
   "confidence": "high",
   "notes": "Regret R_n = sup_u E[sum <y_t,a_t>] - sum <y_t,u>, recorded as pseudo-regret. Per-round complexity O(d)."
  },
