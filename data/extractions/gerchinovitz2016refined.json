   "source": {
    "label": "thm:high-prob",
    "number": "Theorem 1",
    "quote": "Suppose $K \\geq 2$ and $\\delta \\in (0,1/4)$ and $T \\geq 32 (K-1) \\log(2/\\delta)$, then there exists a sequence of losses $\\ell_{1:T} \\in [0,1]^{KT}$ such that $\\Pr{R_T(\\ell_{1:T}) \\geq \\frac{1}{27} \\sqrt{(K-1)T \\log(1/(4\\delta))}} \\geq \\delta/2$"
   },
   "confidence": "high",
   "notes": "Lower bound on the (1-delta/2)-quantile type regret; probability >= delta/2 of exceeding."
  },
