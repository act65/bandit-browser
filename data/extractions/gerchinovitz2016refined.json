   "source": {
    "label": "thm:high-prob-uniform",
    "number": "Theorem 2",
    "quote": "Suppose $K \\geq 2$, $T \\geq 1$, and there exists a strategy and constant $C > 0$ such that for any $\\ell_{1:T}$ it holds that $\\E[R_T(\\ell_{1:T})] \\leq C \\sqrt{(K-1)T}$. ... Then there exists $\\ell_{1:T}$ for which $\\Pr{R_T(\\ell_{1:T}) \\geq \\frac{\\sqrt{(K-1)T}\\log(1/(4\\delta))}{203 C}} \\geq \\delta / 2$"
   },
   "confidence": "high",
   "notes": "Corollary 3 (non-existence of a strategy with P(R_T >= C sqrt((K-1)T) log^p(1/delta)) <= delta for all delta, p<1) follows; not recorded separately."
  },
