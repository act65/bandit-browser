   "bound": {
    "notation": "liminf",
    "expression": "log(T)/Kinf_i",
    "expression_latex": "\\liminf_{T \\to \\infty} \\frac{\\E_{\\unu}[N_{\\psi,a}(T)]}{\\ln T} \\geq \\frac{1}{\\Kinf(\\nu_a,\\mu^\\star,\\cD)}",
    "regime": "T -> infinity"
   },
   "symbols": {},
   "conditions": [
    "strategy is uniformly fast convergent on D (E[N_a(T)] = o(T^alpha) for all alpha in (0,1])",
    "a is a suboptimal arm",
    "no further regularity conditions on the model D"
   ],
   "tuning": [],
   "is_new": false,
   "source": {
    "label": "th:asympt",
    "number": "Theorem (th:asympt)",
    "quote": "For all models $\\mathcal{D}$, for all uniformly fast convergent strategies $\\psi$ on $\\cD$, for all bandit problems $\\unu$, for all suboptimal arms $a$, \\[ \\liminf_{T \\to \\infty} \\frac{\\E_{\\unu}[N_{\\psi,a}(T)]}{\\ln T} \\geq \\frac{1}{\\Kinf(\\nu_a,\\mu^\\star,\\cD)}\\,. \\]"
   },
   "confidence": "medium",
   "notes": "Bound on expected pull count of each suboptimal arm (regret follows via sum Delta_a E[N_a]). Re-derivation of Lai-Robbins / Burnetas-Katehakis with a new simpler proof and without mild conditions on D; marked is_new false as the bound itself is known."
  },
