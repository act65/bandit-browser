    "expression": "sum_subopt(2*c_A*(v_A/Delta_i)**(1/eps_m)*log(T) + 5*Delta_i)",
    "expression_latex": "R_n \\leq \\sum_{i \\,:\\, \\Delta_i > 0} \\left(2c \\left(\\frac{v}{\\Delta_i}\\right)^{\\frac{1}{\\epsilon}} \\log n + 5\\Delta_i\\right)",
    "regime": null
