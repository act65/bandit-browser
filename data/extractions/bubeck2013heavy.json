    "expression": "T**(1/(1+eps_m))*(4*K*c_A*log(T))**(eps_m/(1+eps_m))*v_A**(1/(1+eps_m))",
    "expression_latex": "R_n \\leq n^{\\frac{1}{1+\\epsilon}} \\bigg(4Kc\\log n\\bigg)^{\\frac{\\epsilon}{1+\\epsilon}} v^{1/(1+\\epsilon)}",
    "regime": "log(T) >= max_i 5*Delta_i**((1+eps_m)/eps_m)/(2*c_A*v_A**(1/eps_m))"
   },
   "symbols": {
    "c_A": "constant c of Assumption 1",
    "v_A": "constant v of Assumption 1"
   },
   "conditions": [
