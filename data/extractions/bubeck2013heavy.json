   "conditions": [
    "the mean estimator satisfies Assumption 1 with parameters (eps, c, v) for every arm's distribution"
   ],
   "tuning": [
    "estimator confidence delta = t^{-2}"
   ],
   "is_new": true,
   "source": {
    "label": "prop:rucb",
    "number": "Proposition 1",
    "quote": "Suppose that the distributions $\\nu_1, \\hdots, \\nu_K$ are such that the mean estimator satisfies Assumption \\ref{ass:est} for all $i=1,\\ldots,K$. Then the regret of the Robust {\\sc ucb} policy satisfies R_n \\leq \\sum_{i \\,:\\, \\Delta_i > 0} \\left(2c \\left(\\frac{v}{\\Delta_i}\\right)^{\\frac{1}{\\epsilon}} \\log n + 5\\Delta_i\\right)"
   },
   "confidence": "high",
   "notes": "Regret defined through means: pseudo-regret. Algorithm uses delta=t^{-2}, so anytime."
  },
  {
   "id": "r2",
   "setting": "s1",
   "side": "upper",
   "algorithm": "a1",
   "algorithm_class": null,
   "quantity": "pseudo_regret",
