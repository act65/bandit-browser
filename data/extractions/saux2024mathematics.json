    "expression": "sum_subopt(Delta_i/Kinf_i)*log(T)",
    "expression_latex": "\\liminf_{T\\to+\\infty} \\frac{E[R_T]}{\\log T} \\geq \\sum_{k\\neq k^\\star} \\frac{\\Delta_k^{\\rho,\\nu}}{K_{inf}^{F_k,\\rho}(\\nu_k;\\rho^\\star(\\nu))}",
