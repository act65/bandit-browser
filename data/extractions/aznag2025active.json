  {
   "id": "r1",
   "setting": "s1",
   "side": "upper",
   "algorithm": "a1",
   "algorithm_class": null,
   "quantity": "other",
   "dependence": "instance_dependent",
   "comparator": "not_applicable",
   "probability": "expectation",
   "horizon": "known",
   "compute": "polynomial",
   "bound": {
    "notation": "O",
    "expression": "P_fail*T + w_bar_inf + K/T",
    "expression_latex": "\\mathbb{P}[(0 \\leq UCB - \\sigma \\leq \\sigma w)^c] T + (1 + o(1))(\\bar{w}_\\infty(\\sigma, w) + \\frac{G}{T})",
    "regime": "p = infinity; T -> infinity"
   },
   "symbols": {
    "P_fail": "probability that the UCB procedure violates 0 <= UCB - sigma <= sigma*w for some group/time",
    "w_bar_inf": "decision error induced by (sigma, admissible width w) for p = infinity"
   },
   "conditions": [
    "any instance in H, any UCB procedure, any admissible width w"
   ],
   "tuning": [
    "p = infinity"
   ],
   "is_new": true,
   "source": {
    "label": "theorem:upperboundinfinite",
    "number": "Theorem (theorem:upperboundinfinite)",
    "quote": "For any instance D in H with variance vector sigma^2, any UCB-procedure UCB, and any admissible width w, Algorithm Variance-UCB(+infty,T,UCB) satisfies Regret_{infty,T} <= P[(0 <= UCB - sigma <= sigma w)^c] T + (1 + o(1))(w_bar_infty(sigma, w) + G/T)."
   },
   "confidence": "medium",
   "notes": "Normalized (multiplicative) regret on the infinity-norm of variance vector; G = K groups. Second term has factor (1+o(1)); recorded with O notation, constant 1 on the second term."
  },
