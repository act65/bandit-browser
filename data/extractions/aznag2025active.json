   "source": {
    "label": "theorem:upperboundinfinite",
    "number": "Theorem (theorem:upperboundinfinite)",
    "quote": "For any instance D in H with variance vector sigma^2, any UCB-procedure UCB, and any admissible width w, Algorithm Variance-UCB(+infty,T,UCB) satisfies Regret_{infty,T}(V-UCB, D|H) <= P[(0 <= UCB - sigma <= sigma w)^c] T + (1 + o(1))(bar{w}_infty(sigma, w) + G/T)."
   },
   "confidence": "medium",
   "notes": "Normalized (multiplicative) regret on the max-variance objective; quantity 'other'. G = number of groups mapped to K. (1+o(1)) factor dropped from expression."
  },
