   "is_new": true,
   "source": {
    "label": "thm:reg_exp3",
    "number": "Theorem 3.1",
    "quote": "Suppose that Assumption~\\ref{asmp:regularity} holds. Assume that $\\mX$ is finite. Furthermore, set $\\lambda \\geq 1$, $\\beta = B\\sqrt{\\lambda/T}$, $\\eta \\in (0, \\overline{\\eta})$, and $\\alpha = 2\\eta (2 B \\gamma_T + \\beta \\sqrt{\\gamma_T})$ ... Then, \\algoref{alg:exp3} satisfies $\\bar{R}_T \\leq 2\\alpha B T + \\frac{\\log |\\mX|}{\\eta} + 8 \\eta (\\lambda + T) B^2 \\gamma_T + 4B\\sqrt{\\lambda T \\gamma_T}$."
   },
   "confidence": "high",
   "notes": "Regret defined as sup_x E[sum f_t(x) - f_t(x_t)]; recorded as pseudo_regret. Per-round cost O(|X|^3), polynomial in |X|."
  },
