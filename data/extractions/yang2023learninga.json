   "unmapped": [
    "Learner displays any subset S of size >= 2 and observes a single chosen item (multiway choice feedback)",
    "Choice probabilities are p-separable: consistent with a strict global ranking with f(i|S) <= p f(i'|S) whenever i' ranked above i",
    "The learner knows the separation parameter p (or an upper bound on it)"
   ],
   "definition_quote": "Let $p\\in(0,1)$ be a fixed dispersion parameter. A preference $f$ belongs to the $p$-Separable family $\\mathcal M_p$ if:\n\\label{definition_p_family}\n\\begin{enumerate}[label = (\\roman*), noitemsep, nolistsep]\n\\item For any $S\\in\\mathcal S$, $f(i | S)>0$  if and only if $i\\in S$;\n\\item For any $S\\in\\mathcal S$, $\\sum_{i\\in S}f(i | S)=1$;\n\\item There exists a global ranking $\\sigma_f: [K]\\to [K]$ such that for any $S\\in\\mathcal S$ and $i, i'\\in S$, $f(i|S)\\le p f(i'|S) $ if  $\\sigma_f(i')<\\sigma_f(i)$.\n\\end{enumerate}"
  },
