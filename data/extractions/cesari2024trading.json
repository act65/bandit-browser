    "expression": "log(T)",
    "expression_latex": "c_1 \\ln T",
    "regime": "T >= c_2"
   },
   "symbols": {},
   "conditions": [
    "worst case over distributions with 2-Lipschitz cdf",
    "T >= c_2 for a numerical constant c_2"
   ],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "t:lower-bound-full-M",
    "number": "Theorem 2",
    "quote": "There exist two numerical constants $c_1$ and $c_2$ such that, for any time horizon $T \\ge c_2$, the worst-case regret of any full-feedback algorithm satisfies \\[ \\sup_{\\nu\\in\\cD_2} R_T^\\nu \\ge c_1 \\ln T \\;, \\] where ... $\\cD_2$ is the set of all distributions $\\nu$ that admit a $2$-Lipschitz cdf."
   },
   "confidence": "high",
   "notes": "Proof gives c_1 = (1/16)(1/12 - pi/(16 sqrt 6)) and T >= 144. Since 2-Lipschitz cdfs are continuous, this matches Theorem 1."
  },
