   "is_new": true,
   "source": {
    "label": "t:mbs",
    "number": "Theorem 3",
    "quote": "If $\\nu$ has an $M$-Lipschitz cdf $F$, for some $M\\ge 1$, then, for all time horizons $T\\in \\N$, the regret of MBS tuned with parameters $\\delta\\coloneqq \\fracc{2}{T^3}$ and $n\\coloneqq T$ satisfies \\[ R_T \\le 2 + 6\\log_2(MT) \\ln(T)\\;. \\]"
   },
   "confidence": "high",
   "notes": "Algorithm does not need M, but needs T."
