    "expression_latex": "\\ExpVal{R_n} \\le \\ExpVal{(G^*_n+1) f_\\Base(n/(G^*_n+1))} \\le (\\ExpVal{G^*_n}+1) f_\\Base\\left(\\dfrac{n}{\\ExpVal{G^*_n}+1}\\right)",
    "regime": null
   },
   "symbols": {
    "f_Base": "non-delayed (expected) regret bound of base algorithm: nondecreasing, concave, f(0)=0",
    "EG_star": "expected maximum number of outstanding feedbacks E[G*_n] during the first n steps"
   },
   "conditions": [
    "delays independent of the forecaster's predictions",
    "Base enjoys an (expected) regret bound f_Base"
   ],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "thm:BOLD-Expected-Bound",
    "number": "Theorem 1",
    "quote": "Suppose that the non-delayed algorithm \\Base used in BOLD enjoys an (expected) regret bound $f_\\Base$. Assume, furthermore, that the delays $\\tau_t$ are independent of the forecaster's prediction $a_t$. Then the expected regret of BOLD after $n$ time steps satisfies \\ExpVal{R_n} \\le \\ExpVal{(G^*_n+1) f_\\Base(n/(G^*_n+1))} \\le (\\ExpVal{G^*_n}+1) f_\\Base(n/(\\ExpVal{G^*_n}+1))."
   },
   "confidence": "medium",
   "notes": "Reduction result; recorded the second (looser) inequality. Horizon dependence inherits from Base. With constant delay recovers Weinberger & Ordentlich bound (tau+1) f(n/(tau+1))."
  },
