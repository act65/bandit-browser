    "regime": null
   },
   "symbols": {
    "Q": "upper bound on (1/2) q(lambda_{1:T}) + 2 sum_t ||s_t||^2 + 4 sum_t max_i s_{i,t} * d(lambda_t), where q is relative quadratic variation of lower bounds and s are slacks"
   },
   "conditions": [
    "oblivious adversary",
    "min_i lambda_{i,t} >= 0 WLOG"
   ],
   "tuning": [
    "any eta > 0"
   ],
   "is_new": true,
   "source": {
    "label": "thm:Exp3.LB",
    "number": "Theorem 1",
    "quote": "Let $\\ubQ$ be an upper bound on $$\\frac{1}{2} q(\\blb_{1:T})+2\\sum_{t=1}^T \\|\\bs_t\\|^2+4\\sum_{t=1}^T \\max_i\\{s_{i,t}\\}\\cdot\\diff(\\blb_t)\\;.$$ Then for any $\\eta > 0$ it holds that $$\\psR_{Exp3.LB,T} \\leq \\frac{1}{\\eta}\\log N + \\frac{1}{4}\\eta \\ubQ\\;,$$"
   },
   "confidence": "high",
   "notes": "Paper's N (experts) mapped to K. Horizon marked known since bound holds for fixed T with eta arbitrary."
  },
