    "expression_latex": "\\sum_{i\\in [m], K_i>0} \\left(\\ell_n(\\Delta^i_{\\min},p_i) \\Delta^i_{\\min} + \\int_{\\Delta^i_{\\min}}^{\\Delta^i_{\\max}} \\ell_n(x,p_i) \\mathrm{d}x\\right ) + \\left(\\frac{(2+\\I\\{p^* < 1\\})\\pi^2}{6} +1\\right)\\cdot m \\cdot  \\Delta_{\\max}",
    "regime": null
   },
   "symbols": {
    "m_base": "number of base arms m",
    "Delta_i_min": "smallest gap alpha*opt - r(S) among bad super arms whose triggering set contains base arm i",
    "Delta_max": "largest gap among bad super arms",
    "ell_n_min_i": "sampling threshold ell_n(Delta_i_min, p_i): max(12 ln n/((f^{-1}(Delta))^2 p), 24 ln n/p) if p<1, 6 ln n/(f^{-1}(Delta))^2 if p=1",
    "Int_ell_i": "integral of ell_n(x, p_i) dx from Delta_i_min to Delta_i_max",
    "I_p": "indicator that p_star < 1",
    "p_i": "minimum nonzero triggering probability of base arm i"
   },
   "conditions": [
    "expected reward is monotone and satisfies bounded smoothness with function f",
    "uses an (alpha,beta)-approximation oracle",
