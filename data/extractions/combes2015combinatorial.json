   },
   "conditions": [],
   "tuning": [],
   "is_new": true,
   "source": {
    "label": "thm:C_theta",
    "number": "Theorem 1",
    "quote": "For all $\\theta\\in \\Theta$, for any uniformly good policy $\\pi\\in \\Pi$,\\; $\\liminf_{T\\to\\infty} {R^\\pi(T)\\over \\log(T)} \\ge c(\\theta),$ where $c(\\theta)$ is the optimal value of the optimization problem: \\inf_{x \\in {\\cal X}} \\sum_{M} x_M (M^\\star(\\theta) - M)^\\top \\theta s.t. (\\sum_M x_M M)^\\top \\klber(\\theta,\\lambda) \\ge 1, \\forall \\lambda \\in B(\\theta)."
   },
   "confidence": "high",
   "notes": "Derived via Graves & Lai (1997) controlled Markov chains."
  },
