    "expression_latex": "T^{\\star}_{\\ell}(\\boldsymbol{\\nu} ; \\epsilon) \\geq \\max\\{ T^{\\star}_{\\mathrm{KL}}(\\boldsymbol{\\nu}) , c(\\epsilon)^{-1} T^{\\star}_{\\mathrm{TV}^2}(\\boldsymbol{\\nu}) \\}",
    "regime": null
   },
   "symbols": {
    "T_KL": "non-private KL characteristic time",
    "T_TV2": "characteristic time with squared TV distance as distinguishability measure"
   },
   "conditions": [
    "delta-correct epsilon-local DP pair (mechanism, BAI strategy)",
    "instance with unique best arm"
