   "bound": {
    "notation": "O_tilde",
    "expression": "sqrt((v**2/mu_alg + mu_alg + v)*T) + K**2/mu_alg + K**2/T**(3/2)",
    "expression_latex": "\\tilde{\\Ocal}\\left(\\sqrt{\\left(\\frac{v^2}{\\mu}+\\mu+v\\right)T}+\\frac{k^2}{\\mu}+\\frac{k^2}{T^{3/2}}\\right)",
    "regime": "T large enough that (1+beta)^2 <= 2"
