   },
   "conditions": [
    "holds with probability at least 1-delta-P(v,delta,mu) (data/algorithm-dependent probability)"
   ],
   "tuning": [
    "eta = 1/sqrt(mu T)",
    "beta = 2 eta sqrt(6 log(3k/delta))",
    "gamma = eta^2(1+beta)^2 k^2"
   ],
   "is_new": true,
   "source": {
    "label": "thm:mab",
    "number": "Theorem 1",
    "quote": "Suppose that $T$ is sufficiently large (and thus $\\eta$ and $\\beta$ sufficiently small) so that $(1+\\beta)^2\\leq 2$. Then for any $v\\in [1,k]$, it holds that with probability at least $1-\\delta-P(v,\\delta,\\mu)$ that the sequence of rewards ... returned by Algorithm 1 satisfies max_i sum g_i(t) - sum g_{i_t}(t) <= \\tilde{O}(sqrt((v^2/mu+mu+v)T)+k^2/mu+k^2/T^{3/2})"
   },
   "confidence": "medium",
   "notes": "Tilde-O hides log factors in k and delta. With mu=v=K, P=0 and bound becomes O_tilde(sqrt(KT)) w.p. 1-delta (discussed in text)."
  },
