  {
   "id": "r1",
   "setting": "s1",
   "side": "upper",
   "algorithm": "a1",
   "algorithm_class": null,
   "quantity": "pseudo_regret",
   "dependence": "instance_dependent",
   "comparator": "best_fixed_action",
   "probability": "expectation",
   "horizon": "anytime",
   "compute": "polynomial",
   "bound": {
    "notation": "O",
    "expression": "sum_subopt(Delta_i + v_mom*log(T*Delta_i**2/v_mom)/Delta_i) + T*Delta_small",
    "expression_latex": "\\sum_{i\\in [K]:\\Delta_i>\\lambda} O\\bigg(\\Delta_i+\\frac{V\\log(T\\Delta_i^2/V)}{\\Delta_i} \\bigg)+\\max_{i\\in [K],\\Delta_i\\leq \\lambda} \\Delta_i \\cdot T",
    "regime": "any lambda >= 16*sqrt(V/T); sum restricted to arms with Delta_i > lambda"
   },
   "symbols": {
    "v_mom": "uniform upper bound V on the variance of the exponential family distributions",
    "Delta_small": "max gap among arms with Delta_i <= lambda (lambda >= 16 sqrt(V/T) a free analysis threshold)"
   },
   "conditions": [
    "variance of family bounded by V"
   ],
   "tuning": [
    "b_n = (n-1)/n"
   ],
   "is_new": true,
   "source": {
    "label": "thm:regret_rots",
    "number": "Theorem 4",
    "quote": "Let $b_n=(n-1)/n$. ... The regret of Algorithm 1 satisfies ... $R_{\\mu}(T)=\\sum_{i\\in [K]:\\Delta_i>\\lambda} O\\bigg(\\Delta_i+\\frac{V\\log(T\\Delta_i^2/V)}{\\Delta_i} \\bigg)+\\max_{i\\in [K],\\Delta_i\\leq \\lambda} \\Delta_i \\cdot T$ ... where $\\lambda \\geq 16\\sqrt{V/T}$"
   },
   "confidence": "medium",
   "notes": "Sub-UCB bound. The sum is only over arms with gap above lambda; the max term is outside the O. Regret defined as T*max mu - E[sum r_t], equals pseudo-regret."
  },
